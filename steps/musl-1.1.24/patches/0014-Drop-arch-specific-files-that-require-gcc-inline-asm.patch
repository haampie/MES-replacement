index da9bb26..864843d 100644
--- a/arch/aarch64/bits/alltypes.h.in
+++ b/arch/aarch64/bits/alltypes.h.in
@@ -2,8 +2,8 @@
 #define _Int64 long
 #define _Reg long
 
-TYPEDEF struct { void *__stack; void *__gr_top; void *__vr_top; int __gr_offs; int __vr_offs; } va_list;
-TYPEDEF struct { void *__stack; void *__gr_top; void *__vr_top; int __gr_offs; int __vr_offs; } __isoc_va_list;
+TYPEDEF struct __va_list_struct { void *__stack; void *__gr_top; void *__vr_top; int __gr_offs; int __vr_offs; } va_list;
+TYPEDEF struct __va_list_struct __isoc_va_list;
 
