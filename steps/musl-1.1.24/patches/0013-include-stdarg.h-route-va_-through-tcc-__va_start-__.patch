From c0a251de28b83d0a2e1be08f6ff61444a2ee0e0d Mon Sep 17 00:00:00 2001
From: Harmen Stoppels <harmen@stoppels.ch>
Date: Sun, 31 May 2026 09:55:11 +0200
Subject: [PATCH 13/21] include/stdarg.h: route va_* through tcc
 __va_start/__va_arg

---
 include/stdarg.h | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)
 create mode 100644 include/stdarg.h

diff --git a/include/stdarg.h b/include/stdarg.h
new file mode 100644
index 0000000..d1e7aa8
--- /dev/null
+++ b/include/stdarg.h
@@ -0,0 +1,23 @@
+#ifndef _STDARG_H
+#define _STDARG_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define __NEED_va_list
+
+#include <bits/alltypes.h>
+
+/* tcc 0.9.26 aarch64: __builtin_va_* are not implemented; libtcc1
+   exports __va_start/__va_arg taking the AAPCS64 va_list struct. */
+#define va_start(ap, last) __va_start(ap, last)
+#define va_arg(ap, type)   __va_arg(ap, type)
+#define va_end(ap)
+#define va_copy(d, s)      ((d) = (s))
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
-- 
